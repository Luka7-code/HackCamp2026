# Existing application
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
PORT=8000
ISSUER_BASE_URL=
CLIENT_ID=
SECRET=
BASE_URL=http://localhost:8000
MANAGER_EMAILS=

# Procurement
PROCUREMENT_ENABLED=true
PROCUREMENT_ABSOLUTE_MAX_AMOUNT=5000
PROCUREMENT_DEFAULT_CURRENCY=USD
PROCUREMENT_COMPANY_NAME=Warehouse WMS
PROCUREMENT_APPROVAL_MODE=HUMAN
PROCUREMENT_MAX_AUTO_APPROVE_AMOUNT=500
PROCUREMENT_MONTHLY_BUDGET=10000
PROCUREMENT_MAX_PO_QUANTITY=1000
PROCUREMENT_AUTO_SEND_EMAIL=false

# Google Gemini (live approval only; leave blank to require human review)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=8000

# Gmail SMTP (nodemailer). Use a Gmail App Password, not the account password.
GMAIL_ADDRESS=
GMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Dev harnesses
PROCUREMENT_HARNESS_PORT=8097
UI_HARNESS_PORT=8098
HARNESS_PORT=8099
